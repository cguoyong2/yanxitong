# Yanxitong production environment template.
# Copy values into your deployment secret manager. Do not commit real secrets.

APP_ENV=production
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Shanghai

# Database
DB_URL=jdbc:mysql://mysql.example.internal:3306/yanxitong?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=yanxitong_app
DB_PASSWORD=replace-with-managed-secret
MYSQL_ROOT_PASSWORD=replace-with-managed-root-secret
MYSQL_DATABASE=yanxitong

# Redis
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-managed-secret
REDIS_DATABASE=0

# Payment safety gates
PAYMENT_DEFAULT_PROVIDER=WECHAT_DIRECT
PAYMENT_MOCK_SUCCESS_ENABLED=false
PAYMENT_MOCK_CALLBACK_SECRET=replace-with-non-default-local-only-secret

# Payment query compensation and unpaid-order timeout close.
PAYMENT_MAINTENANCE_ENABLED=true
PAYMENT_MAINTENANCE_QUERY_AFTER=PT1M
PAYMENT_MAINTENANCE_PENDING_TIMEOUT=PT30M
PAYMENT_MAINTENANCE_RETRY_DELAY=PT2M
PAYMENT_MAINTENANCE_BATCH_SIZE=50
PAYMENT_MAINTENANCE_FIXED_DELAY_MS=60000
PAYMENT_MAINTENANCE_INITIAL_DELAY_MS=30000

# WeChat direct merchant payment.
PAYMENT_WECHAT_DIRECT_ENABLED=true
PAYMENT_WECHAT_MERCHANT_ID=replace-with-direct-merchant-id
PAYMENT_WECHAT_APP_ID=replace-with-miniapp-app-id
PAYMENT_WECHAT_CERT_SERIAL_NO=replace-with-merchant-certificate-serial
WECHAT_SECRETS_DIR=/opt/apps/yanxitong/secrets/wechat
PAYMENT_WECHAT_PRIVATE_KEY_PATH=/run/secrets/wechat/apiclient_key.pem
PAYMENT_WECHAT_API_V3_KEY=replace-with-api-v3-key
PAYMENT_WECHAT_NOTIFY_URL=https://your-domain.example.com/api/payments/callbacks/wechat-direct

# WeChat service-provider payment. Leave disabled for direct merchant mode.
PAYMENT_WECHAT_SP_ENABLED=false
PAYMENT_WECHAT_SERVICE_PROVIDER_ID=replace-with-service-provider-merchant-id
PAYMENT_WECHAT_SUB_MERCHANT_ID=replace-with-sub-merchant-id
PAYMENT_WECHAT_SUB_APP_ID=replace-with-sub-merchant-app-id-if-used

# WeChat miniapp login. Required for JSAPI payment payer openid.
WECHAT_MINIAPP_APP_ID=replace-with-miniapp-app-id
WECHAT_MINIAPP_APP_SECRET=replace-with-miniapp-app-secret

# Certificate verification mode.
# AUTO uses SDK auto certificate management when supported by deployment wiring.
# PLATFORM_CERTIFICATE requires PAYMENT_WECHAT_PLATFORM_CERTIFICATE_PATH.
# PUBLIC_KEY requires PAYMENT_WECHAT_PUBLIC_KEY_ID and PAYMENT_WECHAT_PUBLIC_KEY_PATH.
PAYMENT_WECHAT_CERTIFICATE_MODE=AUTO
PAYMENT_WECHAT_PLATFORM_CERTIFICATE_PATH=
PAYMENT_WECHAT_PUBLIC_KEY_ID=
PAYMENT_WECHAT_PUBLIC_KEY_PATH=
